# Backend Server Configuration
PORT=5050

# CORS Configuration - Danh sách các origin được phép truy cập (phân tách bởi dấu phẩy)
ALLOWED_ORIGINS=https://dailyenglishlesson.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:5050,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5050,http://127.0.0.1:3000

# Mật khẩu bảo vệ ứng dụng (Đặt mật khẩu cá nhân của bạn để đăng nhập)
APP_PASSWORD=your_secure_password_here

# Supabase Configuration
# Lấy thông tin tại: Supabase Dashboard -> Settings -> API / Project Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
